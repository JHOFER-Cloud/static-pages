{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>JHOFER-Cloud/renovate-presets//default"],
  "reviewers": ["ojsef39"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "lockFileMaintenance": {
        "enabled": false
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/templates/base\\.njk/"],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/npm/(?<depName>(?:@[^@/]+/)?[^@/]+)@(?<currentValue>[^/]+)/\\+esm"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
